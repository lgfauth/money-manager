{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Schedule": {
    "TimeZoneId": "E. South America Standard Time",
    "Hour": 8,
    "Minute": 0,
    "LoopDelaySeconds": 30
  },
  "InvoiceClosureSchedule": {
    "TimeZoneId": "E. South America Standard Time",
    "Hour": 0,
    "Minute": 1,
    "LoopDelaySeconds": 60
  },
  "OverdueInvoiceSchedule": {
    "TimeZoneId": "E. South America Standard Time",
    "Hour": 3,
    "Minute": 15,
    "LoopDelaySeconds": 60
  },
  "FinancialHealthSnapshotSchedule": {
    "TimeZoneId": "E. South America Standard Time",
    "Hour": 1,
    "Minute": 30,
    "LoopDelaySeconds": 60
  },
  "Worker": {
    "ExecutionTimeoutMinutes": 5
  },
  "Encryption": {
    "Key": "${Encryption__Key}"
  },
  "InvoiceImport": {
    "PollIntervalSeconds": 10,
    "MaxAttempts": 3,
    "StuckAfterMinutes": 25,
    "QueuedExpirationHours": 24,
    "JobTimeoutMinutes": 20,
    "MaxJobsPerCycle": 5,
    "DefaultModelReads": 3,
    "FallbackModel": "claude-sonnet-5-5"
  },
  "Anthropic": {
    "ApiKey": "${Anthropic__ApiKey}",
    "Model": "claude-haiku-5-5"
  },
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": ""
  }
}
